---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import StackTag from '../../components/StackTag.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = (await getCollection('projetos')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<'projetos'>;
  next: CollectionEntry<'projetos'>;
}

const { project, next } = Astro.props;
const { title, summary, category, stack, highlights, status, year, links } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <article class="container-page max-w-4xl py-12 sm:py-16">
    <a
      href={`${url()}#projetos`}
      class="inline-flex min-h-11 items-center gap-2 font-mono text-sm text-muted hover:text-accent"
    >
      ← cd ../projetos
    </a>

    <header class="mt-6">
      <p class="eyebrow">
        {category} · {year}
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{summary}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        {links.live && (
          <a href={links.live} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Ver online ↗
          </a>
        )}
        {links.repo && (
          <a href={links.repo} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            Código no GitHub ↗
          </a>
        )}
      </div>
    </header>

    <div class="card mt-10 overflow-hidden">
      <ProjectCover project={project} eager />
    </div>

    <dl class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
      <div class="bg-surface p-5">
        <dt class="font-mono text-xs text-accent uppercase">Status</dt>
        <dd class="mt-1">{status}</dd>
      </div>
      <div class="group bg-surface p-5 sm:col-span-2">
        <dt class="font-mono text-xs text-accent uppercase">Stack</dt>
        <dd class="mt-2 flex flex-wrap gap-2">
          {stack.map((tech) => (
            <StackTag name={tech} />
          ))}
        </dd>
      </div>
    </dl>

    <section class="card mt-6 p-6" aria-label="Destaques">
      <ul class="space-y-2">
        {highlights.map((item) => (
          <li class="flex gap-3 text-ink">
            <span class="font-mono text-accent" aria-hidden="true">
              ✓
            </span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <div class="prose-case mt-4">
      <Content />
    </div>

    {next.id !== project.id && (
      <a
        href={url(`projetos/${next.id}/`)}
        class="card group mt-16 flex items-center justify-between gap-4 p-6 hover:border-line-strong"
      >
        <span>
          <span class="block font-mono text-xs text-muted">Próximo projeto</span>
          <span class="mt-1 block text-xl font-semibold">{next.data.title}</span>
        </span>
        <span
          class="text-2xl text-accent transition-transform group-hover:translate-x-1"
          aria-hidden="true"
        >
          →
        </span>
      </a>
    )}
  </article>
</BaseLayout>
