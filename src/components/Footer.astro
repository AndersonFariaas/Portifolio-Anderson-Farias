---
import { site } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {site.name}. Todos os direitos reservados.
    </p>
    <div class="flex items-center gap-6">
      <a href={site.github} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
        GitHub
      </a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-ink">
        LinkedIn
      </a>
      <a href={`${url()}#inicio`} class="hover:text-accent">
        Voltar ao topo ↑
      </a>
    </div>
  </div>
</footer>
