---
import type { CollectionEntry } from 'astro:content';
import ProjectCover from './ProjectCover.astro';
import StackTag from './StackTag.astro';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projetos'>;
  wide?: boolean;
}

const { project, wide = false } = Astro.props;
const { title, summary, category, stack, highlights, status, links } = project.data;
const caseUrl = url(`projetos/${project.id}/`);
---

<article
  class:list={[
    'group card relative flex flex-col overflow-hidden transition-colors duration-300 hover:border-line-strong',
    wide && 'lg:col-span-2',
  ]}
  data-reveal
>
  <!-- A capa fica sempre em cima, em 16:9: aparece inteira e preenche a largura do card. -->
  <ProjectCover project={project} />

  <!-- No card largo (lg+), o texto vira duas colunas: resumo e links à esquerda, destaques e stack à direita. -->
  <div
    class:list={[
      'flex flex-1 flex-col p-6 sm:p-8',
      wide && 'lg:grid lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-x-12',
    ]}
  >
    <div class:list={[wide && 'lg:col-start-1 lg:row-start-1']}>
      <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
        <span class="text-accent">{category}</span>
        <span class="text-line-strong" aria-hidden="true">
          /
        </span>
        <span class="flex items-center gap-1.5 text-muted">
          <span
            class:list={[
              'size-1.5 rounded-full',
              status === 'Em produção' ? 'bg-accent' : 'bg-muted',
            ]}
            aria-hidden="true"
          ></span>
          {status}
        </span>
      </div>

      <h3 class="text-2xl font-semibold tracking-tight">
        <a href={caseUrl} class="after:absolute after:inset-0 focus-visible:outline-none">
          {title}
        </a>
      </h3>
      <p class="mt-3 leading-relaxed text-muted">{summary}</p>
    </div>

    <div class:list={[wide && 'lg:col-start-2 lg:row-span-2 lg:row-start-1']}>
      {wide && (
        <ul class="mt-5 space-y-2 text-sm text-muted lg:mt-0">
          {highlights.map((item) => (
            <li class="flex gap-2">
              <span class="font-mono text-accent" aria-hidden="true">
                ›
              </span>
              {item}
            </li>
          ))}
        </ul>
      )}

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tecnologias">
        {stack.slice(0, wide ? 8 : 5).map((tech) => (
          <li>
            <StackTag name={tech} />
          </li>
        ))}
      </ul>
    </div>

    <div
      class:list={[
        'mt-auto flex flex-wrap items-center gap-3 pt-7',
        wide && 'lg:col-start-1 lg:row-start-2 lg:self-end',
      ]}
    >
      {links.live && (
        <a
          href={links.live}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary relative z-10"
        >
          Ver online ↗<span class="sr-only">: {title}</span>
        </a>
      )}
      {links.repo && (
        <a
          href={links.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost relative z-10"
        >
          Ver código ↗<span class="sr-only">: {title}</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  /* O link do título cobre o card inteiro; o foco vai para a borda do card. */
  article:has(h3 a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
</style>
