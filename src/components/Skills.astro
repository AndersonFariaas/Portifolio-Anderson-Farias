---
import SectionHeading from './SectionHeading.astro';
import TechIcon from './TechIcon.astro';
import { areas } from '../data/areas';
import { stack } from '../data/tech';
---

<section
  id="habilidades"
  class="container-page py-20 sm:py-28"
  aria-labelledby="habilidades-titulo"
>
  <SectionHeading index="03" title="Habilidades" id="habilidades-titulo" />

  <h3 class="mb-5 font-mono text-sm text-muted" data-reveal>
    <span class="text-accent">$</span> ls ./areas
  </h3>
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {areas.map((area) => (
      <li class="area-card card p-4 sm:p-5" data-reveal>
        <svg
          class="area-icon mb-3 sm:mb-4"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={area.icon} />
        </svg>
        <p class="text-sm font-semibold text-ink sm:text-base">{area.title}</p>
        <p class="mt-1 text-xs leading-relaxed text-muted sm:text-sm">{area.description}</p>
      </li>
    ))}
  </ul>

  <h3 class="mt-16 mb-5 font-mono text-sm text-muted" data-reveal>
    <span class="text-accent">$</span> ls ./stack
  </h3>
  <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-7" data-reveal>
    {stack.map((tech) => (
      <li class="tech-tile flex flex-col items-center gap-2.5 rounded-xl border border-line bg-surface px-2 py-4 text-center">
        <TechIcon tech={tech} size={28} />
        <span class="text-xs text-muted">{tech.name}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .area-icon {
    color: var(--color-muted);
    transition: color 0.25s var(--ease-soft);
  }

  .tech-tile {
    transition:
      border-color 0.25s var(--ease-soft),
      transform 0.25s var(--ease-soft);
  }

  /* Cor da marca só com mouse: no toque não existe hover, então fica o tom neutro. */
  @media (hover: hover) {
    .area-card:hover .area-icon {
      color: var(--color-accent);
    }

    .tech-tile:hover {
      border-color: var(--color-line-strong);
      transform: translateY(-2px);
    }

    .tech-tile:hover :global(.tech-icon) {
      color: var(--brand);
    }
  }
</style>
